# Copy to .env and fill in. Never commit .env.

# Owner role: migrations, run logs, approvals.
DATABASE_URL=postgresql+psycopg://retailops:retailops@localhost:5432/retailops
# Read-only role used ONLY by the SQL tool (created by `python -m scripts.create_ro_role`).
DATABASE_URL_RO=postgresql+psycopg://retailops_ro:change-me@localhost:5432/retailops

# LLM provider: anthropic (paid) | gemini (free key) | groq (free key) | ollama (local, free)
LLM_PROVIDER=gemini
# Leave empty for the provider default: claude-haiku-4-5 | gemini-3.8-flash | openai/gpt-oss-120b | qwen2.5:7b
LLM_MODEL=
ANTHROPIC_API_KEY=
# Free key, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# Protect the bill: hard daily cap (GBP) across all keys, and a per-key rate limit.
DAILY_SPEND_CAP_GBP=2.0
RATE_LIMIT=20/minute
REQUIRE_API_KEY=true

# Optional tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
